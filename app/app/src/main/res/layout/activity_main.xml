<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold" android:text="Service off" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="13sp"
            android:text="Setup: ① Install (Play Protect blocks accessibility apps shared via chat/browser in some countries: install over adb, or pause Play Protect scanning). ② Android 13+: App info → ⋮ → Allow restricted settings. ③ Enable the accessibility service. ④ Enter hub URL + token, Connect. ⑤ Allow background so the connection survives Doze." />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Hub URL" />
        <EditText android:id="@+id/hubUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="wss://mobile.example.com or ws://10.0.2.2:17692" android:inputType="textUri" android:importantForAutofill="no" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Device name" />
        <EditText android:id="@+id/deviceName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="My phone" android:inputType="text" android:importantForAutofill="no" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Device token (hosted hubs only)" />
        <EditText android:id="@+id/token" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="MOBILEMCP_TOKEN" android:inputType="textPassword" android:importantForAutofill="no" />

        <CheckBox android:id="@+id/autoConnect" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Connect automatically when the service starts" />

        <Button android:id="@+id/appInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="App info (allow restricted settings)" />
        <Button android:id="@+id/enableService" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="1. Enable accessibility service" />
        <Button android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="2. Connect" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="13sp"
            android:text="Optional permissions: notification access enables reading/replying to notifications and Do Not Disturb; modify system settings enables brightness and rotation." />
        <Button android:id="@+id/notificationAccess" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Notification access" />
        <Button android:id="@+id/writeSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Modify system settings" />
        <Button android:id="@+id/battery" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Allow background (ignore battery optimization)" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Log" android:textStyle="bold" />
        <TextView android:id="@+id/log" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="11sp" android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
