# Hosted hub (optional). Local stdio use needs none of these.
# Bind address; keep 127.0.0.1 unless a reverse proxy is in front.
MOBILEMCP_HOST=127.0.0.1
MOBILEMCP_PORT=17692
# Public HTTPS origin the phone and remote agents connect through (requires a token).
#MOBILEMCP_PUBLIC_URL=https://mobile.example.com
# One shared token for the phone (hello.token) and agents (Authorization: Bearer). 32+ chars.
#MOBILEMCP_TOKEN=change-me-to-a-long-random-string-xxxxxxxx
# Or several isolated accounts: [{"id":"me","agentToken":"...","deviceToken":"..."}]
#MOBILEMCP_ACCOUNTS=
